<?xml version="1.0" encoding="utf-8"?>
<resources>
	<style name="Theme.Heddohon" parent="android:Theme.Material.NoActionBar">
		<item name="android:windowBackground">@color/ground</item>
		<item name="android:statusBarColor">@color/ground</item>
		<item name="android:navigationBarColor">@color/ground</item>
		<item name="android:colorAccent">@color/accent</item>
		<item name="android:textColorPrimary">@color/text</item>
	</style>

	<!-- What shows for the moment before the browser takes over: the ground, and nothing on it. -->
	<style name="Theme.Heddohon.Launch">
		<item name="android:windowNoTitle">true</item>
		<item name="android:windowDisablePreview">false</item>
	</style>
</resources>
