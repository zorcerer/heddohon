<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

	<!-- For the one check the address screen makes: that a Heddohon answers at the address typed. -->
	<uses-permission android:name="android.permission.INTERNET" />

	<application
		android:allowBackup="true"
		android:icon="@mipmap/ic_launcher"
		android:label="@string/app_name"
		android:supportsRtl="true"
		android:theme="@style/Theme.Heddohon">

		<!-- Opens the saved server in a Trusted Web Activity, or the address screen on a first run. -->
		<activity
			android:name=".MainActivity"
			android:exported="true"
			android:theme="@style/Theme.Heddohon.Launch">
			<intent-filter>
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.LAUNCHER" />
			</intent-filter>
			<meta-data
				android:name="android.app.shortcuts"
				android:resource="@xml/shortcuts" />
		</activity>

		<!-- Exported for the launcher's shortcut. It only ever shows the address screen. -->
		<activity
			android:name=".SetupActivity"
			android:exported="true"
			android:windowSoftInputMode="adjustResize" />
	</application>
</manifest>
