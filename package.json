{
	"name": "heddohon",
	"description": "Server-rendered, high-resolution music player for Navidrome/Subsonic and Jellyfin libraries.",
	"private": true,
	"version": "0.2.0",
	"type": "module",
	"license": "MIT",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node build/index.js",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"test:e2e": "node --test 'tests/e2e/*.test.mjs'",
		"test:browser": "node --test 'tests/browser/*.test.mjs'",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/ibm-plex-sans": "^5.3.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/manrope": "^5.3.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/better-sqlite3": "^9.6.0",
		"@types/pg": "^8.23.1",
		"playwright": "^1.63.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"better-sqlite3": "^13.0.3",
		"pg": "^8.23.0"
	}
}
