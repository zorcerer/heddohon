{
	"name": "heddohon",
	"description": "Server-rendered, high-resolution music player for Navidrome/Subsonic and Jellyfin libraries.",
	"private": true,
	"version": "0.9.0",
	"type": "module",
	"license": "MIT",
	"engines": {
		"node": ">=22.17"
	},
	"scripts": {
		"dev": "vite dev",
		"dev:mock": "node tests/dev-mock.mjs",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node build/index.js",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc -p src/service-worker",
		"test:e2e": "node --test 'tests/e2e/*.test.mjs'",
		"test:browser": "node --test 'tests/browser/*.test.mjs'",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/ibm-plex-sans": "^5.3.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/manrope": "^5.3.0",
		"@fontsource/barlow": "^5.3.0",
		"@fontsource/barlow-condensed": "^5.3.0",
		"@fontsource/dotgothic16": "^5.3.1",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.4",
		"@types/better-sqlite3": "^9.6.0",
		"@types/pg": "^8.23.1",
		"gsap": "^3.15.1",
		"motion": "^14.9.1",
		"ogl": "^1.0.11",
		"playwright": "^1.63.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.5",
		"tailwindcss": "^4.3.4",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"better-sqlite3": "^13.0.3",
		"pg": "^8.23.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
