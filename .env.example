# Heddohon settings. Copy to .env and fill in the first two sections.
# Every variable is described at https://github.com/zorcerer/heddohon/wiki/Configuration

# ── Required ──────────────────────────────────────────────────────────────────
# At least 32 characters: openssl rand -base64 48. Changing it signs everyone out.
HEDDOHON_SECRET=

# ── Music servers: at least one. Private addresses work ───────────────────────
HEDDOHON_SUBSONIC_URL=http://10.0.0.10:4533
HEDDOHON_JELLYFIN_URL=http://10.0.0.10:8096
HEDDOHON_SUBSONIC_LABEL=Navidrome
HEDDOHON_JELLYFIN_LABEL=Jellyfin

# ── Address and cookies ───────────────────────────────────────────────────────
# The address people open. Required behind a reverse proxy.
ORIGIN=https://music.example.com
# auto, true or false. Set false where the app is reached over plain http.
HEDDOHON_COOKIE_SECURE=auto
HEDDOHON_SESSION_HOURS=720

# ── Storage ───────────────────────────────────────────────────────────────────
HEDDOHON_DATA_DIR=/data
HEDDOHON_COVER_CACHE_MB=2048
HEDDOHON_UPSTREAM_TIMEOUT_MS=20000

# PostgreSQL in place of SQLite.
# HEDDOHON_DATABASE_URL=postgres://db.lan:5432/heddohon
# HEDDOHON_DATABASE_USER=heddohon
# HEDDOHON_DATABASE_PASSWORD=
# HEDDOHON_DATABASE_PASSWORD_FILE=/run/secrets/heddohon_db
# HEDDOHON_DATABASE_SSL=require
# HEDDOHON_DATABASE_IMPORT=true

# ── Features ──────────────────────────────────────────────────────────────────
HEDDOHON_SHARING=true
HEDDOHON_DOWNLOADS=true
HEDDOHON_FOLDERS=true
HEDDOHON_RADIO=true
# HEDDOHON_RADIO_PRIVATE=true
# Set false when several Heddohon processes run behind a load balancer.
HEDDOHON_REMOTE_CONTROL=true

# ── Third parties: off by default. On, the server contacts the host named ─────
HEDDOHON_LYRICS_LRCLIB=false
# HEDDOHON_LYRICS_LRCLIB_URL=https://lrclib.net
HEDDOHON_AUTOEQ=false
# HEDDOHON_AUTOEQ_URL=https://raw.githubusercontent.com/jaakkopasanen/AutoEq/master/results
HEDDOHON_DISCORD=false
# HEDDOHON_DISCORD_URL=https://discord.com
HEDDOHON_LISTENBRAINZ=false
# HEDDOHON_LISTENBRAINZ_URL=https://api.listenbrainz.org

# ── Logging ───────────────────────────────────────────────────────────────────
# error, warn, info or debug.
HEDDOHON_LOG_LEVEL=error
# HEDDOHON_LOG_FORMAT=json
HEDDOHON_LOG_SLOW_MS=2000
HEDDOHON_LOG_KEEP_DAYS=7

# ── Sign-in screen and the Android app ────────────────────────────────────────
HEDDOHON_APP_NAME=Heddohon
# HEDDOHON_LOGIN_HINT=Use the same account as your Navidrome login.
# HEDDOHON_ANDROID_FINGERPRINTS=AA:BB:...
