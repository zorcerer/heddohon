# Heddohon settings. Every line is optional, and so is this file.
# Every variable is described at https://github.com/zorcerer/heddohon/wiki/Configuration
#
# Started without a secret or a music server, Heddohon prints a code to its log
# and the page it serves takes the code, the address of the music server and
# where it is opened, and makes the secret. What it saves is in setup.json in
# the data directory. A variable set here takes precedence over a saved one.
#
# To configure it here instead, copy this to .env and fill in the first two
# sections.

# ── Required ──────────────────────────────────────────────────────────────────
# At least 32 characters: openssl rand -base64 48. Changing it signs everyone out.
HEDDOHON_SECRET=

# ── Music servers: at least one. Private addresses work ───────────────────────
HEDDOHON_SUBSONIC_URL=http://10.0.0.10:4533
HEDDOHON_JELLYFIN_URL=http://10.0.0.10:8096
HEDDOHON_SUBSONIC_LABEL=Navidrome
HEDDOHON_JELLYFIN_LABEL=Jellyfin

# ── Address and cookies ───────────────────────────────────────────────────────
# The address people open. Required behind a reverse proxy that does not pass
# the host on. Left out, the address can be saved from the first-run setup or
# by an administrator under Settings, Storage, and changed there later.
ORIGIN=https://music.example.com
# auto, true or false. Set false where the app is reached over plain http, unless
# its http:// address on the local network was saved as above.
HEDDOHON_COOKIE_SECURE=auto
HEDDOHON_SESSION_HOURS=720

# ── Storage ───────────────────────────────────────────────────────────────────
HEDDOHON_DATA_DIR=/data
HEDDOHON_COVER_CACHE_MB=2048
HEDDOHON_UPSTREAM_TIMEOUT_MS=20000

# PostgreSQL in place of SQLite.
# HEDDOHON_DATABASE_URL=postgres://db.lan:5432/heddohon
# HEDDOHON_DATABASE_USER=heddohon
# HEDDOHON_DATABASE_PASSWORD=
# HEDDOHON_DATABASE_PASSWORD_FILE=/run/secrets/heddohon_db
# HEDDOHON_DATABASE_SSL=require
# HEDDOHON_DATABASE_IMPORT=true

# ── Features ──────────────────────────────────────────────────────────────────
HEDDOHON_SHARING=true
HEDDOHON_DOWNLOADS=true
HEDDOHON_FOLDERS=true
# The theme an account starts in: terminal, liquid, paper or phosphor. Each account can
# change its own under Settings.
HEDDOHON_DEFAULT_THEME=terminal
# false: a start without the secret or a music server is an error, as before
# 0.7.0, and the setup page is not served.
# HEDDOHON_SETUP=true
HEDDOHON_RADIO=true
# HEDDOHON_RADIO_PRIVATE=true
# Set false when several Heddohon processes run behind a load balancer.
HEDDOHON_REMOTE_CONTROL=true
# Accounts that turn it on in Settings see what each other is playing. Needs
# HEDDOHON_REMOTE_CONTROL.
HEDDOHON_LISTENERS=true

# ── Navidrome plugin: off unless a token is set ───────────────────────────────
# Lets the Heddohon plugin for Navidrome send the plays made in other apps, and
# the whole scrobble history for an import. At least 32 characters, and not
# HEDDOHON_SECRET: openssl rand -hex 32. The plugin's settings take the same value.
# HEDDOHON_NAVIDROME_PLUGIN_TOKEN=

# ── AI assistants: off by default ─────────────────────────────────────────────
# Lets each account make a token under Settings for an assistant that speaks the
# Model Context Protocol (Claude Code, for one), which then searches its library
# at /api/mcp and, if the token allows it, changes its playlists, favourites and
# ratings. What the assistant reads goes to whoever runs its model. Left unset,
# the first-run setup and an administrator under Settings, AI, turn it on and off;
# set here, it is decided here.
# HEDDOHON_MCP=true

# ── Third parties: off by default. On, the server contacts the host named ─────
HEDDOHON_LYRICS_LRCLIB=false
# HEDDOHON_LYRICS_LRCLIB_URL=https://lrclib.net
HEDDOHON_AUTOEQ=false
# HEDDOHON_AUTOEQ_URL=https://raw.githubusercontent.com/jaakkopasanen/AutoEq/master/results
HEDDOHON_DISCORD=false
# HEDDOHON_DISCORD_URL=https://discord.com
HEDDOHON_LISTENBRAINZ=false
# HEDDOHON_LISTENBRAINZ_URL=https://api.listenbrainz.org

# ── Logging ───────────────────────────────────────────────────────────────────
# error, warn, info or debug.
HEDDOHON_LOG_LEVEL=error
# HEDDOHON_LOG_FORMAT=json
HEDDOHON_LOG_SLOW_MS=2000
HEDDOHON_LOG_KEEP_DAYS=7

# ── Sign-in screen and the Android app ────────────────────────────────────────
HEDDOHON_APP_NAME=Heddohon
# HEDDOHON_LOGIN_HINT=Use the same account as your Navidrome login.
# HEDDOHON_ANDROID_FINGERPRINTS=AA:BB:...
