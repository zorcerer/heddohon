# ── Required ──────────────────────────────────────────────────────────────────
# Encrypts music-server credentials at rest and derives session token keys.
# Must be at least 32 characters. Generate one with:
#   openssl rand -base64 48
# Rotating this invalidates every stored credential and signs everyone out.
HEDDOHON_SECRET=

# ── Music servers ─────────────────────────────────────────────────────────────
# Set at least one. These URLs are resolved by the Heddohon server process, so
# private addresses are fine — users never connect to them directly and never
# see them. Users only supply a username and password.
HEDDOHON_SUBSONIC_URL=http://10.0.0.10:4533
HEDDOHON_JELLYFIN_URL=http://10.0.0.10:8096

# Alias accepted for the Subsonic URL if you prefer it:
# HEDDOHON_NAVIDROME_URL=http://10.0.0.10:4533

# ── Optional ──────────────────────────────────────────────────────────────────
# Names shown on the sign-in screen when both servers are configured.
HEDDOHON_SUBSONIC_LABEL=Navidrome
HEDDOHON_JELLYFIN_LABEL=Jellyfin

# Session lifetime in hours. Hard-capped at 72; larger values are clamped down.
HEDDOHON_SESSION_HOURS=72

# Where the SQLite database and the cover cache live. Mount this as a volume.
HEDDOHON_DATA_DIR=/data

# Disk budget for cached cover art, in megabytes, under HEDDOHON_DATA_DIR/covers.
# The least recently used files are dropped once it is exceeded. 0 switches the
# cache off and every cover is fetched from the music server again.
HEDDOHON_COVER_CACHE_MB=2048

# Song links. true lets accounts make links anyone can open without an account.
# false hides the share buttons and stops every existing link from opening; the
# links are kept and work again if this is set back to true.
HEDDOHON_SHARING=true

# Keep the database on a PostgreSQL server instead of SQLite in the data
# directory. An existing SQLite database is copied across on first start. See
# docs/configuration.md#postgresql.
# HEDDOHON_DATABASE_URL=postgres://db.lan:5432/heddohon
# HEDDOHON_DATABASE_USER=heddohon
# HEDDOHON_DATABASE_PASSWORD=
# HEDDOHON_DATABASE_SSL=require

# The "Download original" link in the player. false removes it and its route.
HEDDOHON_DOWNLOADS=true

# Lyrics from LRCLIB for tracks the music server has no synced lyrics for.
# Off by default: when true, the artist, title, album and length of each such
# track are sent to LRCLIB (or to the URL below) when its lyrics are opened.
HEDDOHON_LYRICS_LRCLIB=false
# HEDDOHON_LYRICS_LRCLIB_URL=https://lrclib.net

# error, warn, info or debug. The default is error: a server that is working
# writes nothing. warn adds refused writes and rejected sign-ins, info adds who
# signed in and what the server started with, debug adds a line per request and
# per call to the music server, which is the setting for working out why a page
# is slow and costs about 15% of throughput on cover-heavy pages. json emits one
# object per line for a log collector.
HEDDOHON_LOG_LEVEL=error
# HEDDOHON_LOG_FORMAT=json
# Requests taking at least this long are logged as request-slow. 0 disables it.
HEDDOHON_LOG_SLOW_MS=2000

# Public origin, required behind a reverse proxy for CSRF origin checks.
ORIGIN=https://music.example.com

# `auto` marks the session cookie Secure when the request arrives over https,
# when NODE_ENV=production (the default in the Docker image), or when the host is
# not loopback. In the Docker image that means always, so a deployment reached
# over plain http needs false. Force it with true/false if your setup needs
# that. Where the cookie is Secure it is named __Host-heddohon_session, and
# changing which name applies signs everyone out once.
HEDDOHON_COOKIE_SECURE=auto

# How long to wait on the music server before giving up, in milliseconds.
HEDDOHON_UPSTREAM_TIMEOUT_MS=20000

# Branding and an optional line of text on the sign-in screen.
HEDDOHON_APP_NAME=Heddohon
# HEDDOHON_LOGIN_HINT=Use the same account as your Navidrome login.
